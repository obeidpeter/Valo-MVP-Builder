modules = ["nodejs-24", "python-3.11", "postgresql-16"]

[deployment]
router = "application"
deploymentTarget = "autoscale"
build = "PORT=3000 BASE_PATH=/ NODE_ENV=production pnpm run build"
run = "CORS_ALLOWED_ORIGINS=https://valo-mvp-builder.replit.app VALO_PUBLIC_LEAD_DESTINATION=database TRUST_PROXY=1 NODE_ENV=production node --enable-source-maps scripts/start-replit-production.mjs"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "test"
author = "agent"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/valo-workbench run test"

[[workflows.workflow]]
name = "API"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "PORT=5000 NODE_ENV=development pnpm --filter @workspace/api-server run dev"

[[workflows.workflow]]
name = "Workbench"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "PORT=3000 BASE_PATH=/ API_PROXY_TARGET=http://127.0.0.1:5000 pnpm --filter @workspace/valo-workbench run dev"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "API"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Workbench"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[nix]
channel = "stable-25_05"

[userenv]

[userenv.shared]
VALO_RELEASE_SHA256 = "c157374ee725fc8eeb0a186981158e43a170f91ed323d73522e2e840ad033096"
AUTHENTICATED_RATE_LIMIT_MAX_REQUESTS = "120"
AUTHENTICATED_RATE_LIMIT_WINDOW_SECONDS = "60"
AUTHENTICATED_ACTOR_RATE_LIMIT_MAX_REQUESTS = "180"
AUTHENTICATED_ACTOR_RATE_LIMIT_WINDOW_SECONDS = "60"
CLERK_ADAPTER_PRODUCTION_APPROVED = "true"
