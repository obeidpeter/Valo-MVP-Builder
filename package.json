{
  "name": "workspace",
  "version": "0.0.0",
  "license": "MIT",
  "packageManager": "pnpm@10.34.0",
  "engines": {
    "node": ">=22 <25",
    "pnpm": ">=10.34 <11"
  },
  "scripts": {
    "preinstall": "node ./scripts/enforce-pnpm.mjs",
    "build": "pnpm run typecheck && pnpm -r --if-present run build",
    "format:check": "node ./scripts/check-format-changed.mjs",
    "lint": "node ./scripts/lint-policy.mjs",
    "verify:release-config": "node ./scripts/verify-release-config.mjs",
    "typecheck:libs": "tsc --build",
    "typecheck": "pnpm run typecheck:libs && pnpm -r --filter \"./artifacts/**\" --filter \"./scripts\" --if-present run typecheck"
  },
  "private": true,
  "devDependencies": {
    "prettier": "^3.8.4",
    "typescript": "~5.9.3"
  }
}
