{
  "schemaVersion": 1,
  "packId": "valo-observability-v2.5",
  "status": "deployment_adapter_required",
  "defaults": {
    "evaluationWindowMinutes": 5,
    "owner": "valo_operations",
    "runbookBase": "docs/implementation-v2.5/runbooks"
  },
  "alerts": [
    {
      "id": "api_error_rate",
      "severity": "critical",
      "signal": "http.server.error_ratio",
      "condition": ">= 0.05 for 10m",
      "runbook": "INCIDENT_RESPONSE.md"
    },
    {
      "id": "processing_job_failure_rate",
      "severity": "critical",
      "signal": "valo.processing_jobs.failure_ratio",
      "condition": ">= 0.10 for 10m",
      "runbook": "INCIDENT_RESPONSE.md"
    },
    {
      "id": "extraction_quality_regression",
      "severity": "critical",
      "signal": "valo.extraction.mandatory_recall",
      "condition": "< 0.95 on promoted holdout",
      "runbook": "ROLLBACK.md"
    },
    {
      "id": "tenant_access_denials_spike",
      "severity": "high",
      "signal": "valo.security.tenant_denials",
      "condition": "> baseline + 3 sigma for 10m",
      "runbook": "INCIDENT_RESPONSE.md"
    },
    {
      "id": "sla_breach",
      "severity": "high",
      "signal": "valo.engagement.sla_breaches",
      "condition": "> 0 for 15m",
      "runbook": "INCIDENT_RESPONSE.md"
    },
    {
      "id": "notification_delivery_failure",
      "severity": "high",
      "signal": "valo.notifications.final_failure_count",
      "condition": "> 0 for 15m",
      "runbook": "INCIDENT_RESPONSE.md"
    },
    {
      "id": "storage_deletion_dead_letter",
      "severity": "high",
      "signal": "valo.storage.deletion_dead_letter_transitions",
      "condition": "increase over 15m > 0",
      "runbook": "INCIDENT_RESPONSE.md"
    },
    {
      "id": "storage_deletion_backlog",
      "severity": "high",
      "signal": "valo.storage.deletion_oldest_sampled_age_seconds",
      "condition": "> 3600 for 15m only while valo.storage.deletion_sample_complete = 1",
      "requiresSignals": ["valo.storage.deletion_sample_complete"],
      "runbook": "INCIDENT_RESPONSE.md"
    },
    {
      "id": "storage_deletion_worker_stale",
      "severity": "high",
      "signal": "valo.storage.deletion_last_success_unixtime_seconds",
      "condition": "absent for 30m or time() - value > 1800",
      "runbook": "INCIDENT_RESPONSE.md"
    },
    {
      "id": "storage_deletion_full_cycle_stale",
      "severity": "high",
      "signal": "valo.storage.deletion_last_full_cycle_unixtime_seconds",
      "condition": "absent for 2h or time() - value > 7200",
      "runbook": "INCIDENT_RESPONSE.md"
    },
    {
      "id": "retention_scan_stale",
      "severity": "high",
      "signal": "valo.retention.scan_last_success_unixtime_seconds",
      "condition": "absent for 36h or time() - value > 129600",
      "runbook": "INCIDENT_RESPONSE.md"
    },
    {
      "id": "retention_scan_full_cycle_stale",
      "severity": "high",
      "signal": "valo.retention.scan_last_full_cycle_unixtime_seconds",
      "condition": "absent for 7d or time() - value > configured full-cycle objective",
      "requiresSignals": ["valo.retention.cycle_complete"],
      "runbook": "INCIDENT_RESPONSE.md"
    },
    {
      "id": "public_intake_purge_stale",
      "severity": "high",
      "signal": "valo.intake.purge_last_success_unixtime_seconds",
      "condition": "absent for 36h or time() - value > 129600",
      "runbook": "INCIDENT_RESPONSE.md"
    },
    {
      "id": "authenticated_rate_limit_purge_failure",
      "severity": "high",
      "signal": "valo.authenticated_rate_limit.purge_run_success",
      "condition": "< 1 for one completed invocation",
      "runbook": "INCIDENT_RESPONSE.md"
    },
    {
      "id": "authenticated_rate_limit_purge_stale",
      "severity": "high",
      "signal": "valo.authenticated_rate_limit.purge_last_success_unixtime_seconds",
      "condition": "absent for 2h or time() - value > 7200",
      "runbook": "INCIDENT_RESPONSE.md"
    },
    {
      "id": "authenticated_rate_limit_purge_full_cycle_stale",
      "severity": "high",
      "signal": "valo.authenticated_rate_limit.purge_last_full_cycle_unixtime_seconds",
      "condition": "absent for 24h or time() - value > 86400",
      "requiresSignals": ["valo.authenticated_rate_limit.purge_cycle_complete"],
      "runbook": "INCIDENT_RESPONSE.md"
    },
    {
      "id": "unit_cost_budget",
      "severity": "medium",
      "signal": "valo.ai.cost_per_completed_package",
      "condition": "> configured tenant budget",
      "runbook": "INCIDENT_RESPONSE.md"
    },
    {
      "id": "deployment_health",
      "severity": "critical",
      "signal": "http.readyz.success",
      "condition": "< 1 for 3 consecutive probes",
      "runbook": "ROLLBACK.md"
    },
    {
      "id": "backup_freshness",
      "severity": "critical",
      "signal": "valo.backup.age_hours",
      "condition": "absent after the first scheduled evidence window or > configured RPO",
      "runbook": "BACKUP.md"
    },
    {
      "id": "backup_evidence_verifier_stale",
      "severity": "critical",
      "signal": "valo.backup.last_success_unixtime_seconds",
      "condition": "absent for 36h or time() - value > 129600",
      "runbook": "BACKUP.md"
    },
    {
      "id": "audit_anchor_failure",
      "severity": "critical",
      "signal": "valo.audit.anchor_failures",
      "condition": "> 0",
      "runbook": "INCIDENT_RESPONSE.md"
    },
    {
      "id": "audit_anchor_full_cycle_stale",
      "severity": "critical",
      "signal": "valo.audit.anchor_last_success_unixtime_seconds",
      "condition": "absent for 2h or time() - value > 7200",
      "requiresSignals": ["valo.audit.anchor_cycle_complete"],
      "runbook": "INCIDENT_RESPONSE.md"
    },
    {
      "id": "break_glass_use",
      "severity": "high",
      "signal": "valo.security.break_glass_activated",
      "condition": "> 0",
      "runbook": "INCIDENT_RESPONSE.md"
    }
  ]
}
