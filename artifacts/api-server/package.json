{
  "name": "@workspace/api-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "export NODE_ENV=development && pnpm run build && pnpm run start",
    "build": "node ./build.mjs",
    "start": "node --enable-source-maps ./dist/index.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test 'src/**/*.test.ts'",
    "prove:doctrine": "node --import tsx ./scripts/prove-ai-doctrine.ts --offline",
    "prove:doctrine:offline": "node --import tsx ./scripts/prove-ai-doctrine.ts --offline",
    "prove:injection": "node --import tsx ./scripts/run-injection-corpus.ts --offline",
    "prove:injection:offline": "node --import tsx ./scripts/run-injection-corpus.ts --offline",
    "eval:harness": "node --import tsx ./scripts/run-eval-harness.ts --offline",
    "eval:harness:offline": "node --import tsx ./scripts/run-eval-harness.ts --offline",
    "eval:promote-baseline": "node --import tsx ./scripts/run-eval-harness.ts --promote-baseline",
    "prove:ship": "pnpm run prove:doctrine:offline && pnpm run prove:injection:offline && pnpm run eval:harness:offline",
    "verify:audit": "node --import tsx ./scripts/verify-audit-chain.ts",
    "retention:scan": "node --import tsx ./scripts/run-retention-scan.ts"
  },
  "dependencies": {
    "@clerk/express": "^2.1.35",
    "@clerk/shared": "^4.23.0",
    "@google-cloud/storage": "^7.21.0",
    "@workspace/api-zod": "workspace:*",
    "@workspace/db": "workspace:*",
    "@workspace/integrations-openai-ai-server": "workspace:*",
    "archiver": "^8.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "docx": "^9.7.1",
    "drizzle-orm": "catalog:",
    "express": "^5.2.1",
    "google-auth-library": "^10.9.0",
    "http-proxy-middleware": "^4.1.1",
    "pdf-lib": "^1.17.1",
    "pdf-parse": "^2.4.5",
    "pino": "^9.14.0",
    "pino-http": "^10.5.0"
  },
  "devDependencies": {
    "@types/archiver": "^8.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "catalog:",
    "@types/pdf-parse": "^1.1.5",
    "esbuild": "0.27.3",
    "esbuild-plugin-pino": "^2.3.3",
    "jszip": "^3.10.1",
    "pino-pretty": "^13.1.3",
    "thread-stream": "3.1.0",
    "tsx": "catalog:"
  }
}
